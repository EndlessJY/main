{
  "name": "hack.chat-v2",
  "version": "2.2.1",
  "type": "module",
  "description": "a minimal distraction free chat application",
  "main": "main.mjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hack-chat/main.git"
  },
  "engines": {
    "node": ">= 20",
    "npm": ">= 10"
  },
  "scripts": {
    "start": "node ./scripts/start.js",
    "config": "node ./scripts/config.js",
    "lint": "eslint -- . ",
    "lint:fix": "eslint --fix -- . ",
    "test": "npm run lint && mocha --exit ./test/*.test.js",
    "coverage": "c8 --check-coverage=false mocha --exit ./test/*.test.js",
    "makedocs": "jsdoc -c jsdoc.json"
  },
  "author": "marzavec",
  "license": "MIT",
  "dependencies": {
    "@solana/kit": "^5.1.0",
    "@solana/web3.js": "^1.98.4",
    "ascii-captcha": "^0.0.3",
    "bs58": "^6.0.0",
    "enquirer": "^2.3.6",
    "hackchat-server": "^2.3.2",
    "http-server": "^14.1.0",
    "jsonwebtoken": "^9.0.2",
    "lowdb": "^3.0.0",
    "markdown-escape": "^2.0.0",
    "tweetnacl": "^1.0.3",
    "uwuify": "^1.0.1"
  },
  "devDependencies": {
    "c8": "^7.11.0",
    "chai": "^4.3.6",
    "eslint": "^8.9.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.25.4",
    "mocha": "^11.1.0"
  },
  "overrides": {
    "uuid": "^14.0.0",
    "mocha": {
      "diff": "^9.0.0",
      "serialize-javascript": "^7.0.5"
    }
  }
}
